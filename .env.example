# Railway PostgreSQL bağlantı adresi.
# Vercel ve kendi bilgisayarınız için Railway'deki DATABASE_PUBLIC_URL değerini kullanın.
DATABASE_URL=postgresql://kullanici:sifre@host:port/railway

# Oturumları imzalamak için rastgele uzun bir değer.
AUTH_SECRET=

# Google ile giriş (Google Cloud → Credentials → OAuth client ID).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Yönetici e-postaları (virgülle). Şikâyetleri bu kişiler /admin sayfasından görür.
ADMIN_EMAILS=

# E-postayla kayıt için SMTP (Gmail + uygulama şifresi). Yerelde boşsa kodlar sunucu günlüğüne yazılır.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="Ormaro <adres@gmail.com>"

# İlan çevirisi: Google AI Studio'dan ücretsiz Gemini API anahtarı (kart istemez).
# Boşsa ilanlar yazıldıkları dilde görünür.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# Fotoğraf deposu (Railway → Bucket → Credentials).
BUCKET_ENDPOINT=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_NAME=
BUCKET_REGION=auto

# Yalnızca yerelde: e-postayla deneme girişi ve diske fotoğraf kaydı.
# ALLOW_DEV_LOGIN=1
